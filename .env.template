# Copy this file to .env and fill in real values. Never commit .env.
# NOTION_TOKEN: your internal integration token (already scoped to these two databases).
# *_DATA_SOURCE_ID: open the database in Notion -> "..." menu -> Manage data sources
#   -> click the data source's "..." menu -> Copy data source ID.
NOTION_TOKEN=
FEED_SOURCES_DATA_SOURCE_ID=
CONTENT_INBOX_DATA_SOURCE_ID=

# Optional prune settings (defaults shown). Rows older than PRUNE_AFTER_DAYS with the
# Keep checkbox unchecked are moved to the Notion trash after each ingest.
# PRUNE_ENABLED=1
# PRUNE_AFTER_DAYS=30
# PRUNE_MAX_PER_RUN=1500
# PRUNE_TIME_BUDGET_SECONDS=600
# PRUNE_DRY_RUN=0

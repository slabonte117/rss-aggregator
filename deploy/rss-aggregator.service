[Unit]
Description=RSS Aggregator Worker - fetch feeds and ingest into Notion Content Inbox (Docker)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/home/sean/apps/rss-aggregator
ExecStart=/usr/bin/docker compose run --rm rss-aggregator
User=sean

[Install]
WantedBy=multi-user.target
